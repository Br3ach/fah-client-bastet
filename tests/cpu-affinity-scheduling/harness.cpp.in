#include <set>
#include <map>
#include <vector>
#include <memory>
#include <string>
#include <algorithm>
#include <cassert>
#include <iostream>
#include <cstdint>
#include <stdexcept>
#define THROW(expr) throw runtime_error("Rejected pin policy")
using namespace std;
#define LOG_DEBUG(a,b) do{}while(false)
const int UNIT_RUN=4;
struct Process {bool live=false;bool isSet()const{return live;}};
class Unit {public:
 Process process;bool gpu=false,affinityManaged=false,runningAffinityManaged=false;
 set<unsigned> affinityCPUs,runningAffinityCPUs;unsigned minCPU=1,maxCPU=8,cpus=0;string id="gpu";
 bool hasGPUs()const{return gpu;}bool blocksCPULaunch(const Unit&)const;
 int getState()const{return UNIT_RUN;}set<string> getGPUs()const{return gpu?set<string>{id}:set<string>{};}
 unsigned getMinCPUs()const{return minCPU;}unsigned getMaxCPUs()const{return maxCPU;}string getID()const{return id;}
 void setCPUs(unsigned v){cpus=v;}
};
// RESERVATION_IMPLEMENTATION
struct GroupHarness {
 vector<shared_ptr<Unit>> wus;auto units(){return wus;}
 unsigned schedule(bool managed,unsigned remainingCPUs,set<string> remainingGPUs){
 set<string> enabledWUs;map<string,uint32_t> gpuBaseCPUs;
// GPU_SCHEDULING_IMPLEMENTATION
 for(auto u:wus)assert(enabledWUs.count(u->id));return remainingCPUs;
 }
};
// PIN_VALIDATION_IMPLEMENTATION
// PIN_UNCHANGED_IMPLEMENTATION
int main(){
 Unit next,old;next.affinityManaged=true;next.affinityCPUs={2,3};old.process.live=true;old.runningAffinityManaged=true;old.runningAffinityCPUs={1,2};
 assert(next.blocksCPULaunch(old)); // old live mask, independent of desired policy
 old.affinityCPUs={4,5};assert(next.blocksCPULaunch(old));
 old.runningAffinityCPUs={4,5};assert(!next.blocksCPULaunch(old));
 old.process.live=false;old.runningAffinityCPUs={2};assert(!next.blocksCPULaunch(old));
 old.process.live=true;old.runningAffinityManaged=false;assert(next.blocksCPULaunch(old));
 next.affinityManaged=false;old.runningAffinityManaged=true;assert(next.blocksCPULaunch(old));
 old.runningAffinityManaged=false;assert(!next.blocksCPULaunch(old));
 old.gpu=true;assert(!next.blocksCPULaunch(old));old.gpu=false;next.gpu=true;assert(!next.blocksCPULaunch(old));
 cout<<"PASS: reservation overlap, desired/live distinction, released process, mode transitions, shared GPU helpers\n";
 for(unsigned budget:{0u,1u,8u}){GroupHarness group;for(unsigned minimum:{1u,3u}){auto u=make_shared<Unit>();u->gpu=true;u->id=to_string(minimum);u->minCPU=minimum;group.wus.push_back(u);}assert(group.schedule(true,budget,{"1","3"})==budget);assert(group.wus[0]->cpus==1 && group.wus[1]->cpus==3);}
 GroupHarness legacy;auto u=make_shared<Unit>();u->gpu=true;legacy.wus.push_back(u);assert(legacy.schedule(false,0,{"gpu"})==0);assert(u->cpus==1);
 cout<<"PASS: GPU zero-budget and multiple GPU helpers, CPU budget unchanged, legacy zero-budget GPU\n";
 auto rejected=[](bool pin,bool unchanged,bool supported,bool managed,unsigned cpus,unsigned capacity){try{validatePerformancePin(pin,unchanged,supported,managed,cpus,capacity);return false;}catch(const runtime_error&){return true;}};
 assert(!rejected(true,false,true,false,8,8));
 assert(rejected(true,false,true,false,9,8));
 assert(!rejected(true,false,true,false,16,16));
 assert(rejected(true,false,true,false,17,16));
 assert(rejected(true,false,false,false,1,0));
 assert(!rejected(false,false,false,false,16,0));
 assert(!rejected(true,false,true,true,16,8));
 assert(!rejected(true,true,false,false,8,0));
 // Saved class policy remains configured even when runtime affinity falls back.
 assert(pinUnchanged(true,true,true,true,true,"count","count",8,8));
 assert(!rejected(true,pinUnchanged(true,true,true,true,true,"count","count",8,8),false,false,8,0));
 assert(!pinUnchanged(true,false,true,true,true,"count","count",8,8));
 assert(!pinUnchanged(true,true,true,true,true,"count","count",8,9));
 assert(!pinUnchanged(true,true,false,true,true,"count","count",8,8));
 cout<<"PASS: pinned logical capacity 8/16, API rejection, unavailable classes, GPU-only scope, preserved saved intent\n";
}
