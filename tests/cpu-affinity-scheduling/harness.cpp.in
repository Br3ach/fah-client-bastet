#include <fah/client/RunningCPUAllocation.h>
#include <fah/client/CPUOwnershipPolicy.h>
#include <set>
#include <map>
#include <vector>
#include <memory>
#include <string>
#include <algorithm>
#include <cassert>
#include <iostream>
#include <cstdint>
#include <stdexcept>
#define THROW(expr) throw runtime_error("Rejected pin policy")
using namespace std;using FAH::Client::RunningCPUAllocation;
#define LOG_DEBUG(a,b) do{}while(false)
const int UNIT_RUN=4;
struct Process {bool live=false;bool isSet()const{return live;}};
struct RG {string name;string getName()const{return name;}};
class Unit {public: bool isAssigning() const {return false;}
 shared_ptr<RG> group=make_shared<RG>();
 Process process;bool gpu=false,reserved=false,affinityManaged=false;
 FAH::Client::RunningCPUAllocation runningAllocation;
 set<unsigned> affinityCPUs;unsigned minCPU=1,maxCPU=8,cpus=0;string id="gpu";
 bool hasGPUs()const{return gpu;}
 bool blocksCPULaunch(const Unit&running,const RunningCPUAllocation&desired)const {
  return running.process.isSet() && FAH::Client::CPUOwnershipPolicy::blocksLaunch(
    desired,hasGPUs(),running.runningAllocation,running.hasGPUs());
 }
 bool blocksCPULaunch(const Unit&u)const{return blocksCPULaunch(u,buildDesiredAllocation());}
 FAH::Client::RunningCPUAllocation buildDesiredAllocation()const {
  FAH::Client::RunningCPUAllocation d;d.mode=!desiredAffinityManaged()?FAH::Client::CPUAllocationMode::Unmanaged:desiredGPUReservation()?FAH::Client::CPUAllocationMode::ReservedGPU:gpu?FAH::Client::CPUAllocationMode::SharedGPU:FAH::Client::CPUAllocationMode::ManagedCPU;d.mask=d.resourcePool=affinityCPUs;return d;
 }
 bool desiredGPUReservation()const{return gpu&&reserved;}
 bool desiredAffinityManaged()const{return affinityManaged;}
 set<unsigned> getDesiredAffinity()const{return affinityCPUs;}
 set<unsigned> getDesiredResourceCPUs()const{return affinityCPUs;}
 int getState()const{return UNIT_RUN;}set<string> getGPUs()const{return gpu?set<string>{id}:set<string>{};}
 unsigned getMinCPUs()const{return minCPU;}unsigned getMaxCPUs()const{return maxCPU;}string getID()const{return id;}
 void setScheduledCPUs(unsigned v){cpus=v;}
};
struct GroupHarness {
 vector<shared_ptr<Unit>> wus;auto units(){return wus;}
 unsigned schedule(bool managed,unsigned remainingCPUs,set<string> remainingGPUs){
 set<string> enabledWUs;map<string,uint32_t> gpuBaseCPUs;
// GPU_SCHEDULING_IMPLEMENTATION
 for(auto u:wus)assert(enabledWUs.count(u->id));return remainingCPUs;
 }
};
int main(){
 using Mode=FAH::Client::CPUAllocationMode;
 for(auto a:{Mode::Unmanaged,Mode::ManagedCPU,Mode::SharedGPU,Mode::ReservedGPU})
  for(auto b:{Mode::Unmanaged,Mode::ManagedCPU,Mode::SharedGPU,Mode::ReservedGPU}) {
   RunningCPUAllocation first,second;first.mode=a;second.mode=b;
   assert(first.isManaged()==(a!=Mode::Unmanaged));
   assert(first.isReservedGPU()==(a==Mode::ReservedGPU));
   assert(FAH::Client::CPUOwnershipPolicy::sameExecution(first,second,false)==(a==b));
   assert(FAH::Client::CPUOwnershipPolicy::sameExecution(first,second,true)==(a==b));
  }

 {
  using FAH::Client::CPUOwnershipPolicy;
  RunningCPUAllocation first;
  first.mode=Mode::ManagedCPU;
  first.workers=2;
  first.mask={0,2};
  first.resourcePool={0,1,2,3};

  auto second=first;
  second.resourcePool={0,2};
  assert(CPUOwnershipPolicy::sameExecution(first,second,false));

  second=first;
  second.generation=1;
  assert(CPUOwnershipPolicy::sameExecution(first,second,false));

  second=first;
  second.physical=2;
  assert(CPUOwnershipPolicy::sameExecution(first,second,false));

  second=first;
  second.fullSMT=true;
  assert(CPUOwnershipPolicy::sameExecution(first,second,false));

  second=first;
  second.mask={0,1};
  assert(!CPUOwnershipPolicy::sameExecution(first,second,false));

  second=first;
  second.workers=1;
  assert(!CPUOwnershipPolicy::sameExecution(first,second,false));
 }

 for(auto mode:{Mode::Unmanaged,Mode::ManagedCPU,Mode::SharedGPU,Mode::ReservedGPU}) {
  RunningCPUAllocation first,second;first.mode=second.mode=mode;
  first.workers=1;second.workers=3;
  assert(!FAH::Client::CPUOwnershipPolicy::sameExecution(first,second,false));
  assert(FAH::Client::CPUOwnershipPolicy::sameExecution(first,second,true));
  second.mask={0};
  assert(!FAH::Client::CPUOwnershipPolicy::sameExecution(first,second,true));
 }

 // Valid states: unmanaged CPU/GPU, managed CPU, shared GPU, reserved GPU.
 struct OwnershipCase {Mode mode; bool gpu;};
 const OwnershipCase states[] = {
  {Mode::Unmanaged, false},
  {Mode::Unmanaged, true},
  {Mode::ManagedCPU, false},
  {Mode::SharedGPU, true},
  {Mode::ReservedGPU, true},
 };
 enum Expected {Allow, Block, Overlap};
 const Expected expected[5][5] = {
  {Allow, Allow, Block,   Allow,   Block},
  {Allow, Allow, Allow,   Allow,   Block},
  {Block, Allow, Overlap, Allow,   Overlap},
  {Allow, Allow, Allow,   Allow,   Overlap},
  {Block, Block, Overlap, Overlap, Overlap},
 };
 for (unsigned i=0;i<5;++i) for (unsigned j=0;j<5;++j)
  for (bool overlap: {false,true}) {
   RunningCPUAllocation desired,running;
   desired.mode=states[i].mode;
   running.mode=states[j].mode;
   desired.resourcePool={0,1};
   running.resourcePool=overlap ? set<unsigned>{1,2} : set<unsigned>{2,3};
   const bool blocked=expected[i][j]==Block ||
     (expected[i][j]==Overlap && overlap);
   assert(FAH::Client::CPUOwnershipPolicy::blocksLaunch(
     desired,states[i].gpu,running,states[j].gpu)==blocked);
   assert(FAH::Client::CPUOwnershipPolicy::blocksLaunch(
     running,states[j].gpu,desired,states[i].gpu)==blocked);
  }

 Unit next,old;next.affinityManaged=true;next.affinityCPUs={2,3};old.process.live=true;old.runningAllocation.mode=FAH::Client::CPUAllocationMode::ManagedCPU;old.runningAllocation.resourcePool={1,2};
 assert(next.blocksCPULaunch(old)); // old live mask, independent of desired policy
 old.affinityCPUs={4,5};assert(next.blocksCPULaunch(old));
 old.runningAllocation.resourcePool={4,5};assert(!next.blocksCPULaunch(old));
 old.process.live=false;old.runningAllocation.resourcePool={2};assert(!next.blocksCPULaunch(old));
 old.process.live=true;old.runningAllocation.mode=FAH::Client::CPUAllocationMode::Unmanaged;assert(next.blocksCPULaunch(old));
 next.affinityManaged=false;old.runningAllocation.mode=FAH::Client::CPUAllocationMode::ManagedCPU;assert(next.blocksCPULaunch(old));
 old.runningAllocation.mode=FAH::Client::CPUAllocationMode::Unmanaged;assert(!next.blocksCPULaunch(old));
 old.gpu=true;assert(!next.blocksCPULaunch(old));old.gpu=false;next.gpu=true;assert(!next.blocksCPULaunch(old));
 next.gpu=true;next.reserved=true;next.affinityManaged=true;next.affinityCPUs={2,3};
 old.runningAllocation.mode=FAH::Client::CPUAllocationMode::ManagedCPU;old.runningAllocation.resourcePool={2};assert(next.blocksCPULaunch(old));
 old.gpu=true;old.runningAllocation.mode=FAH::Client::CPUAllocationMode::SharedGPU;assert(next.blocksCPULaunch(old));
 old.runningAllocation.resourcePool={4};assert(!next.blocksCPULaunch(old));
 next.gpu=false;next.reserved=false;old.runningAllocation.mode=FAH::Client::CPUAllocationMode::ReservedGPU;old.runningAllocation.resourcePool={2};assert(next.blocksCPULaunch(old));
 old.process.live=false;assert(!next.blocksCPULaunch(old));
 // An old one-LP mask still owns its whole physical core until exit.
 old.process.live=true;old.gpu=false;old.runningAllocation.mode=FAH::Client::CPUAllocationMode::ManagedCPU;
 old.runningAllocation.resourcePool={0,1};next.gpu=false;next.affinityManaged=true;next.affinityCPUs={1};
 assert(next.blocksCPULaunch(old));
 cout<<"PASS: reservation overlap, desired/live distinction, released process, mode transitions, shared GPU helpers\n";
 // A one-LP shared/reserved helper pool can time-share an assignment's
 // larger accounting minimum. Scheduling neither expands the mask nor
 // subtracts that minimum from the exclusive CPU-worker budget.
 for(bool reserved:{false,true})for(unsigned minimum:{2u,3u,4u}) {
  GroupHarness edge;auto helper=make_shared<Unit>();helper->gpu=true;
  helper->reserved=reserved;helper->affinityManaged=true;
  helper->affinityCPUs={7};helper->minCPU=minimum;edge.wus.push_back(helper);
  assert(edge.schedule(true,0,{"gpu"})==0);
  assert(helper->cpus==minimum && helper->getDesiredAffinity()==set<unsigned>{7});
 }
 cout<<"PASS: one-LP shared/reserved GPU pools retain min_cpus >= 2 accounting without CPU-budget consumption\n";
 for(unsigned budget:{0u,1u,8u}){GroupHarness group;for(unsigned minimum:{1u,3u}){auto u=make_shared<Unit>();u->gpu=true;u->id=to_string(minimum);u->minCPU=minimum;group.wus.push_back(u);}assert(group.schedule(true,budget,{"1","3"})==budget);assert(group.wus[0]->cpus==1 && group.wus[1]->cpus==3);}
 GroupHarness legacy;auto u=make_shared<Unit>();u->gpu=true;legacy.wus.push_back(u);assert(legacy.schedule(false,0,{"gpu"})==0);assert(u->cpus==1);
 // A zero-minimum GPU keeps running resources across global-mode changes,
 // although the scheduling CPU count changes between zero and one.
 GroupHarness transition;auto zero=make_shared<Unit>();zero->gpu=true;zero->minCPU=0;zero->maxCPU=0;transition.wus.push_back(zero);
 transition.schedule(true,0,{"gpu"});assert(zero->cpus==1);
 transition.schedule(false,0,{"gpu"});assert(zero->cpus==0);
 transition.schedule(true,0,{"gpu"});assert(zero->cpus==1);
 cout<<"PASS: GPU zero-budget and multiple GPU helpers, CPU budget unchanged, legacy zero-budget GPU\n";
}
