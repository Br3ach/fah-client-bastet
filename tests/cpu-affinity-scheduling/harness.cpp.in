#include <set>
#include <map>
#include <vector>
#include <memory>
#include <string>
#include <algorithm>
#include <cassert>
#include <iostream>
#include <cstdint>
#include <stdexcept>
#define THROW(expr) throw runtime_error("Rejected pin policy")
using namespace std;
#define LOG_DEBUG(a,b) do{}while(false)
const int UNIT_ASSIGN=0,UNIT_DOWNLOAD=1,UNIT_CORE=2,UNIT_RUN=4;
struct Process {bool live=false;bool isSet()const{return live;}};
struct RG {string name;string getName()const{return name;}};
class Unit {public:
 shared_ptr<RG> group=make_shared<RG>();
 Process process;bool gpu=false,reserved=false,runningGPUReservation=false,affinityManaged=false,runningAffinityManaged=false;
 set<unsigned> affinityCPUs,runningResourceCPUs;unsigned minCPU=1,maxCPU=8,cpus=0;string id="gpu";
 bool hasGPUs()const{return gpu;}bool blocksCPULaunch(const Unit&)const;
 bool desiredGPUReservation()const{return gpu&&reserved;}
 bool desiredAffinityManaged()const{return affinityManaged;}
 set<unsigned> getDesiredAffinity()const{return affinityCPUs;}
 set<unsigned> getDesiredResourceCPUs()const{return affinityCPUs;}
 int state=UNIT_RUN;bool isAssigning()const{return state==UNIT_ASSIGN;}
 void setState(int n){state=n;}
 struct Data {void release(){}} data;
 void resetDownload(){
// DOWNLOAD_REASSIGNMENT_IMPLEMENTATION
 }
 unsigned getCPUs()const{return cpus;}
 unsigned requestCPUs()const {
  struct Sink {unsigned cpus=999;void insert(const string&,unsigned n){cpus=n;}} sink;
// REQUEST_CPU_IMPLEMENTATION
  return sink.cpus;
 }
 int getState()const{return state;}set<string> getGPUs()const{return gpu?set<string>{id}:set<string>{};}
 unsigned getMinCPUs()const{return minCPU;}unsigned getMaxCPUs()const{return maxCPU;}string getID()const{return id;}
 void setCPUs(unsigned v){cpus=v;}
};
// RESERVATION_IMPLEMENTATION
struct GroupHarness {
 vector<shared_ptr<Unit>> wus;auto units(){return wus;}
 unsigned schedule(bool managed,unsigned remainingCPUs,set<string> remainingGPUs){
 set<string> enabledWUs;map<string,uint32_t> gpuBaseCPUs;
// GPU_SCHEDULING_IMPLEMENTATION
 for(auto u:wus)assert(enabledWUs.count(u->id)==!u->isAssigning());return remainingCPUs;
 }
};
int main(){
 for(bool managed:{false,true}) {
  GroupHarness g;auto pending=make_shared<Unit>();pending->gpu=true;
  pending->state=UNIT_ASSIGN;pending->cpus=pending->minCPU=pending->maxCPU=0;
  g.wus={pending};
  for(int n=0;n<3;++n){g.schedule(managed,0,{"gpu"});assert(pending->requestCPUs()==0);}
  pending->state=UNIT_DOWNLOAD;g.schedule(managed,0,{"gpu"});assert(pending->requestCPUs()==0);
  pending->resetDownload();assert(pending->isAssigning());
  g.schedule(managed,0,{"gpu"});assert(pending->requestCPUs()==0);
  pending->state=UNIT_CORE;g.schedule(managed,0,{"gpu"});assert(pending->requestCPUs()==0);
  pending->state=UNIT_RUN;g.schedule(managed,0,{"gpu"});assert(pending->cpus==(managed?1u:0u));
 }
 cout<<"PASS: GPU-only offers survive scheduling and production download-503 reset without helper CPU contamination\n";

 Unit next,old;next.affinityManaged=true;next.affinityCPUs={2,3};old.process.live=true;old.runningAffinityManaged=true;old.runningResourceCPUs={1,2};
 assert(next.blocksCPULaunch(old)); // old live mask, independent of desired policy
 old.affinityCPUs={4,5};assert(next.blocksCPULaunch(old));
 old.runningResourceCPUs={4,5};assert(!next.blocksCPULaunch(old));
 old.process.live=false;old.runningResourceCPUs={2};assert(!next.blocksCPULaunch(old));
 old.process.live=true;old.runningAffinityManaged=false;assert(next.blocksCPULaunch(old));
 next.affinityManaged=false;old.runningAffinityManaged=true;assert(next.blocksCPULaunch(old));
 old.runningAffinityManaged=false;assert(!next.blocksCPULaunch(old));
 old.gpu=true;assert(!next.blocksCPULaunch(old));old.gpu=false;next.gpu=true;assert(!next.blocksCPULaunch(old));
 next.gpu=true;next.reserved=true;next.affinityManaged=true;next.affinityCPUs={2,3};
 old.runningAffinityManaged=true;old.runningResourceCPUs={2};assert(next.blocksCPULaunch(old));
 old.gpu=true;old.runningGPUReservation=false;assert(next.blocksCPULaunch(old));
 old.runningResourceCPUs={4};assert(!next.blocksCPULaunch(old));
 next.gpu=false;next.reserved=false;old.runningGPUReservation=true;old.runningResourceCPUs={2};assert(next.blocksCPULaunch(old));
 old.process.live=false;assert(!next.blocksCPULaunch(old));
 // An old one-LP mask still owns its whole physical core until exit.
 old.process.live=true;old.gpu=false;old.runningAffinityManaged=true;
 old.runningResourceCPUs={0,1};next.gpu=false;next.affinityManaged=true;next.affinityCPUs={1};
 assert(next.blocksCPULaunch(old));
 cout<<"PASS: reservation overlap, desired/live distinction, released process, mode transitions, shared GPU helpers\n";
 for(unsigned budget:{0u,1u,8u}){GroupHarness group;for(unsigned minimum:{1u,3u}){auto u=make_shared<Unit>();u->gpu=true;u->id=to_string(minimum);u->minCPU=minimum;group.wus.push_back(u);}assert(group.schedule(true,budget,{"1","3"})==budget);assert(group.wus[0]->cpus==1 && group.wus[1]->cpus==3);}
 GroupHarness legacy;auto u=make_shared<Unit>();u->gpu=true;legacy.wus.push_back(u);assert(legacy.schedule(false,0,{"gpu"})==0);assert(u->cpus==1);
 // A zero-minimum GPU keeps running resources across global-mode changes,
 // although the scheduling CPU count changes between zero and one.
 GroupHarness transition;auto zero=make_shared<Unit>();zero->gpu=true;zero->minCPU=0;zero->maxCPU=0;transition.wus.push_back(zero);
 transition.schedule(true,0,{"gpu"});assert(zero->cpus==1);
 transition.schedule(false,0,{"gpu"});assert(zero->cpus==0);
 transition.schedule(true,0,{"gpu"});assert(zero->cpus==1);
 cout<<"PASS: GPU zero-budget and multiple GPU helpers, CPU budget unchanged, legacy zero-budget GPU\n";
}
